\newlabel{LastBibItem@cref}{{[subappendix][11][2147483647,5]E\tmspace  +\thinmuskip {.1667em}11}{13}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces EDE histories for tEDS (left column) and $(1-\qopname  \relax o{cos})^3$ (right column). Top: $f_{\rm  EDE}(z)$. Bottom: normalized field $\theta (z)=\phi /f$. The dashed vertical line marks $z_{\rm  eq}$. In tEDS the field rolls off the plateau and rapidly decays to $\theta \to 0$, producing a sharp $f_{\rm  EDE}$ bump. In $(1-\qopname  \relax o{cos})^3$ the field drifts slowly away from the hilltop, producing a broader bump.}}{14}{figure.7}}
\newlabel{fig:histories}{{7}{14}{EDE histories for tEDS (left column) and $(1-\cos )^3$ (right column). Top: $f_{\rm EDE}(z)$. Bottom: normalized field $\theta (z)=\phi /f$. The dashed vertical line marks $z_{\rm eq}$. In tEDS the field rolls off the plateau and rapidly decays to $\theta \to 0$, producing a sharp $f_{\rm EDE}$ bump. In $(1-\cos )^3$ the field drifts slowly away from the hilltop, producing a broader bump}{figure.7}{}}
\newlabel{fig:histories@cref}{{[figure][7][2147483647]7}{14}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Coupling fraction $f_{\rm  coup}(z)$ as a function of redshift. Left: tEDS benchmarks. Right: $(1-\qopname  \relax o{cos})^3$ with $g=0.68$ and $\delta \in \{0.05,\tmspace  +\thinmuskip {.1667em}0.1,\tmspace  +\thinmuskip {.1667em}0.5\}$ and $g\in \{0.68,1\}$. In both potentials $f_{\rm  coup}\approx 1$ at $z>z_{\rm  eq}$, confirming coupling-dominated release. For tEDS, after rolling off the plateau the field oscillates rapidly around $\phi =0$, causing fast oscillations in $f_{\rm  coup}$ (the ratio $|{\rm  coupling}|/|V'|$ alternates sign as the field passes through zero). In $(1-\qopname  \relax o{cos})^3$ the field drifts slowly away from the hilltop and $f_{\rm  coup}$ remains $\approx 1$ throughout since the bare slope is always negligible near $\theta =\pi $.}}{15}{figure.8}}
\newlabel{fig:trigger-coupling}{{8}{15}{Coupling fraction $\fcoup (z)$ as a function of redshift. Left: tEDS benchmarks. Right: $(1-\cos )^3$ with $g=0.68$ and $\delta \in \{0.05,\,0.1,\,0.5\}$ and $g\in \{0.68,1\}$. In both potentials $\fcoup \approx 1$ at $z>z_{\rm eq}$, confirming coupling-dominated release. For tEDS, after rolling off the plateau the field oscillates rapidly around $\phi =0$, causing fast oscillations in $\fcoup $ (the ratio $|{\rm coupling}|/|V'|$ alternates sign as the field passes through zero). In $(1-\cos )^3$ the field drifts slowly away from the hilltop and $\fcoup $ remains $\approx 1$ throughout since the bare slope is always negligible near $\theta =\pi $}{figure.8}{}}
\newlabel{fig:trigger-coupling@cref}{{[figure][8][2147483647]8}{15}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Force budget for $(1-\qopname  \relax o{cos})^3$ at $g=0.68$ and $\delta \in \{2,\tmspace  +\thinmuskip {.1667em}0.5,\tmspace  +\thinmuskip {.1667em}0.1,\tmspace  +\thinmuskip {.1667em}0.01\}$. Top: bare slope $|V_{,\phi }|$. Middle: coupling term $|3\rho _{\rm  IDM}\partial _\phi \qopname  \relax o{ln}m_{\rm  IDM}|$. Bottom: coupling fraction $f_{\rm  coup}(z)$. The coupling dominates ($f_{\rm  coup}\approx 1$) from high redshift until well past the EDE peak for all $\delta $ values. The bare slope is orders of magnitude smaller than the coupling term at $z\gtrsim 10^4$ regardless of $\delta $.}}{16}{figure.9}}
\newlabel{fig:force-budget}{{9}{16}{Force budget for $(1-\cos )^3$ at $g=0.68$ and $\delta \in \{2,\,0.5,\,0.1,\,0.01\}$. Top: bare slope $|V_{,\phi }|$. Middle: coupling term $|3\rIDM \dlnm |$. Bottom: coupling fraction $\fcoup (z)$. The coupling dominates ($\fcoup \approx 1$) from high redshift until well past the EDE peak for all $\delta $ values. The bare slope is orders of magnitude smaller than the coupling term at $z\gtrsim 10^4$ regardless of $\delta $}{figure.9}{}}
\newlabel{fig:force-budget@cref}{{[figure][9][2147483647]9}{16}}
\newlabel{LastPage}{{}{16}{}{}{}}
